#!/usr/bin/env bash
#
# pre-push: run the full verify gate (unit tests + ArchUnit + spotless:check +
# JaCoCo line coverage >= 85%) before code leaves the machine.
#
# Escape hatch: SKIP_HOOKS=1 git push ...   (or git push --no-verify)
set -euo pipefail

if [ -n "${SKIP_HOOKS:-}" ]; then
	echo "pre-push: skipped (SKIP_HOOKS set)"
	exit 0
fi

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; NC=$'\033[0m'
ZERO='0000000000000000000000000000000000000000'

# Decide whether this push touches anything the gate cares about (Java or pom.xml).
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
NEED_GATE=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
	[ -z "${LOCAL_REF:-}" ] && continue
	if [ "$LOCAL_SHA" = "$ZERO" ]; then
		# Branch deletion — nothing to verify.
		continue
	fi
	if [ "$REMOTE_SHA" = "$ZERO" ]; then
		# New branch on the remote: diff against origin/main if we can, else gate.
		BASE=$(git merge-base "$LOCAL_SHA" origin/main 2>/dev/null || echo "")
		RANGE="${BASE:+$BASE }$LOCAL_SHA"
	else
		RANGE="$REMOTE_SHA $LOCAL_SHA"
	fi
	# On any doubt about the diff, run the gate (fail safe — never skip silently).
	if [ -z "$RANGE" ] || ! CHANGED=$(git diff --name-only $RANGE 2>/dev/null); then
		NEED_GATE=1
		break
	fi
	if grep -qE '(\.java$|(^|/)pom\.xml$)' <<<"$CHANGED"; then
		NEED_GATE=1
		break
	fi
done

if [ "$NEED_GATE" -eq 0 ]; then
	echo "pre-push: no Java/pom changes in this push — skipping build gate."
	exit 0
fi

echo "pre-push: running ./mvnw verify (tests + architecture + coverage >= 85%)..."
echo "          (first run on a fresh clone may download Maven/plugins — not a hang)"
if ! ./mvnw -q verify; then
	echo ""
	echo "${RED}pre-push: verify failed — push aborted.${NC}"
	if [ -f target/site/jacoco/index.html ]; then
		LINE=$(awk -F, 'NR>1 {lm+=$4; lc+=$5} END {if (lc+lm>0) printf "%.1f", 100*lc/(lc+lm)}' \
			target/site/jacoco/jacoco.csv 2>/dev/null || echo "")
		[ -n "$LINE" ] && echo "  Current line coverage: ${LINE}% (gate: 85%)."
		echo "  Coverage report: target/site/jacoco/index.html"
	fi
	echo "  If this is a dependency-resolution error, check your ~/.m2/settings.xml auth"
	echo "  for the private Artifact Registry (see README > Troubleshooting)."
	echo "  Emergency bypass: SKIP_HOOKS=1 git push ...  (visible in review — use sparingly)"
	exit 1
fi

echo "${GREEN}pre-push: all gates passed.${NC}"
